#!/bin/sh

echo "Running ./gradlew build prior to commit..."

# Run Gradle build
./gradlew build

# Capture the return code of Gradle
BUILD_RESULT=$?

if [ $BUILD_RESULT -ne 0 ]; then
    echo "--------------------------------------------------"
    echo "Gradle build failed! Commit aborted."
    echo "Fix the build errors above before committing."
    echo "--------------------------------------------------"
    exit 1
fi

exit 0